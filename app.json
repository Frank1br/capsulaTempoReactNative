{
  "expo": {
    "name": "capsulaTempo",
    "slug": "capsulaTempo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "capsulatempo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B4532F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B4532F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "dark": {
            "backgroundColor": "#1A1512",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às suas fotos para guardar uma imagem junto da cápsula.",
          "cameraPermission": "Permita o acesso à câmera para tirar uma foto para a cápsula.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
